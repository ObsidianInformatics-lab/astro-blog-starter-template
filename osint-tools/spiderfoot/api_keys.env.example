# SpiderFoot API keys — TEMPLATE
# -----------------------------------------------------------------------------
# 1. Copy this file to `api_keys.env` (that filename is gitignored — never commit real keys):
#       cp api_keys.env.example api_keys.env
# 2. Paste your keys after the `=` signs (leave blank to skip a provider).
# 3. Load them into SpiderFoot's config store:
#       python3 apply_keys.py
#    From then on, every `sf.py` CLI scan (and the web UI) picks them up automatically.
#
# Each line notes the signup URL and whether a usable FREE tier exists.
# You only need the providers relevant to you — even 3–4 free ones dramatically
# deepen email / name / domain results vs. the keyless baseline.
# =============================================================================

# --- Breach / leak / email-identity (highest value for people & email OSINT) ---
HIBP_API_KEY=          # HaveIBeenPwned breaches      https://haveibeenpwned.com/API/Key   (PAID, ~$4/mo)
HUNTER_API_KEY=        # Hunter.io email discovery     https://hunter.io                    (FREE tier: 25/mo)
INTELX_API_KEY=        # IntelligenceX leaks/darkweb   https://intelx.io                    (FREE tier)
EMAILREP_API_KEY=      # EmailRep reputation           https://emailrep.io                  (FREE tier)
FULLCONTACT_API_KEY=   # FullContact person enrich     https://fullcontact.com              (FREE tier)
DEHASHED_API_KEY=      # Dehashed breach creds         https://dehashed.com                 (PAID)
DEHASHED_USERNAME=     #   ^ Dehashed account email (required alongside DEHASHED_API_KEY)

# --- Infrastructure / domain (for the domain scan) ---
SHODAN_API_KEY=        # Shodan exposed hosts/ports    https://account.shodan.io            (FREE tier)
SECURITYTRAILS_API_KEY=# DNS & subdomain history       https://securitytrails.com           (FREE tier: 50/mo)
BUILTWITH_API_KEY=     # Tech-stack fingerprinting     https://builtwith.com/api            (FREE tier)
ABUSEIPDB_API_KEY=     # IP abuse reputation           https://www.abuseipdb.com/account/api (FREE tier)
GREYNOISE_API_KEY=     # Internet-scanner context      https://www.greynoise.io             (FREE community tier)
